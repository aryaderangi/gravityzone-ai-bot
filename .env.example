# ─────────────────────────────────────────────
# GravityZone AI Bot
# ─────────────────────────────────────────────
BOT_TOKEN=

# ─────────────────────────────────────────────
# Provider keys / endpoints (never hardcoded)
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=
NODE1_URL=https://ol.gravityzoneshop.top
NODE2_URL=https://oll.gravityzoneshop.top
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# ─────────────────────────────────────────────
# Gateway tuning
# ─────────────────────────────────────────────
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_TIMEOUT=60
GATEWAY_RETRIES=1
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# Enterprise (v3.0) — all have sensible defaults
# ─────────────────────────────────────────────
# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN=60

# Request cache
CACHE_TTL=30
CACHE_ENABLED=true

# Concurrency queue
MAX_CONCURRENT=20

# Rate limiter (per Telegram user)
RATE_LIMIT=20
RATE_WINDOW=60

# Background health monitor
HEALTH_MONITOR_INTERVAL=60

# HTTP/2
HTTP2_ENABLED=true

# Admin endpoints (optional shared secret)
# GATEWAY_ADMIN_TOKEN=
